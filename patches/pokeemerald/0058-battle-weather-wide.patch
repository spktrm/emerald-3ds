+// Battle weather (battle_anim_water.c, battle_anim_ice.c, battle_anim_rock.c):
+// the rain, the hail and the crescents of Sandstorm and Heat Wave fall or blow
+// over the GBA's whole screen, and are carried over the wide view as the
+// field's rain is (CtrVideo_MarkWeatherOam). By the template's address only,
+// as IsFogSprite below.
+extern const struct SpriteTemplate gRainDropSpriteTemplate;
+extern const struct SpriteTemplate gHailParticleSpriteTemplate;
+extern const struct SpriteTemplate gFlyingSandCrescentSpriteTemplate;
+
+static bool8 IsBattleWeatherSprite(const struct Sprite *sprite)
+{
+    return sprite->template == &gRainDropSpriteTemplate || sprite->template == &gHailParticleSpriteTemplate
+        || sprite->template == &gFlyingSandCrescentSpriteTemplate;
+}
